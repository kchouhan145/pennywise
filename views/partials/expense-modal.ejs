<div class="modal-backdrop hidden" data-expense-modal aria-hidden="true">
  <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby="expense-modal-title">
    <div class="modal-header">
      <h3 id="expense-modal-title">Add expense</h3>
      <button class="icon-button close-button" type="button" aria-label="Close expense form" data-close-modal>×</button>
    </div>

    <form class="panel-form" method="post" action="/expenses">
      <label>
        Amount
        <input type="number" name="amount" min="0.01" step="0.01" placeholder="0.00" required autofocus />
      </label>

      <div class="input-row two-up">
        <label>
          Category
          <select name="category" required>
            <% categories.forEach((category) => { %>
              <option value="<%= category._id %>"><%= category.name %></option>
            <% }) %>
          </select>
        </label>

        <label>
          Date
          <input type="date" name="date" value="<%= new Date().toISOString().slice(0, 10) %>" required />
        </label>
      </div>

      <label>
        Note
        <input type="text" name="note" maxlength="240" placeholder="Optional note" />
      </label>

      <label>
        Payment method
        <select name="paymentMethod">
          <option value="Cash">Cash</option>
          <option value="UPI">UPI</option>
          <option value="Card" selected>Card</option>
          <option value="Other">Other</option>
        </select>
      </label>

      <button class="primary-button" type="submit">Save expense</button>
    </form>
  </div>
</div>
