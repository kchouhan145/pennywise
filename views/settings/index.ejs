<section class="page-section reveal">
  <div class="report-header">
    <div>
      <p class="eyebrow">Preferences</p>
      <h1>Settings<span class="accent-dot">.</span></h1>
    </div>
    <a class="text-link" href="/">Back to home</a>
  </div>

  <section class="panel-block">
    <% if (errors.length) { %>
      <div class="form-errors" role="alert">
        <% errors.forEach((error) => { %><p><%= error.msg %></p><% }) %>
      </div>
    <% } %>

    <form class="mini-form" method="post" action="/settings">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <div class="input-row two-up">
        <label>
          Default currency
          <select name="currency">
            <option value="INR" <%= formData.currency === 'INR' ? 'selected' : '' %>>INR (₹)</option>
            <option value="USD" <%= formData.currency === 'USD' ? 'selected' : '' %>>USD ($)</option>
            <option value="EUR" <%= formData.currency === 'EUR' ? 'selected' : '' %>>EUR (€)</option>
            <option value="GBP" <%= formData.currency === 'GBP' ? 'selected' : '' %>>GBP (£)</option>
          </select>
        </label>

        <label>
          Theme
          <select name="theme">
            <option value="light" <%= formData.theme === 'light' ? 'selected' : '' %>>Light</option>
            <option value="dark" <%= formData.theme === 'dark' ? 'selected' : '' %>>Dark</option>
          </select>
        </label>
      </div>

      <label>
        <input type="checkbox" name="includeTripsInMonthly" <%= formData.includeTripsInMonthly ? 'checked' : '' %> />
        Include trip expenses in the monthly total
      </label>

      <button class="primary-button" type="submit">Save preferences</button>
    </form>
  </section>

  <section class="panel-block danger-zone">
    <div class="panel-header">
      <h2>Account</h2>
      <p class="muted-copy">Delete your account and all associated expenses, trips, budgets and categories.</p>
    </div>
    <form method="post" action="/settings/delete-account" onsubmit="return confirm('Delete your account and all of your data? This cannot be undone.');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
      <button class="ghost-button" type="submit">Delete account</button>
    </form>
  </section>
</section>
