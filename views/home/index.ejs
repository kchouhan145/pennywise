<section class="dashboard-intro page-section reveal">
  <div>
    <p class="eyebrow">Your money, made clear</p>
    <h1>Good morning<span class="accent-dot">.</span></h1>
    <p class="intro-copy">A quiet view of your spending for <strong><%= monthName %></strong>.</p>
  </div>
  <button class="primary-button" type="button" data-add-expense>
    <span aria-hidden="true">+</span> Add expense
  </button>
</section>

<section class="summary-grid page-section reveal" aria-label="Monthly summary">
  <article class="summary-card summary-card-main">
    <div class="card-heading"><span>Spent this month</span><span class="status-pill"><%= summary.budget ? 'On track' : 'No budget' %></span></div>
    <p class="amount-large"><%= currencySymbol %><%= summary.spent.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
    <div class="progress-track" role="progressbar" aria-label="Monthly budget used" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><span style="width: 0%"></span></div>
    <div class="card-meta"><span><%= summary.budget ? 'Budget set' : 'Budget not set' %></span><span><%= currencySymbol %><%= summary.remaining.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> left</span></div>
  </article>
  <article class="summary-card">
    <span class="card-label">Today</span>
    <p class="amount-medium"><%= currencySymbol %><%= summary.today.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
    <% if (summary.today > 0) { %>
      <p class="muted-copy">Tracked for today</p>
    <% } else { %>
      <p class="muted-copy">No spending recorded yet</p>
    <% } %>
  </article>
</section>

<section class="content-grid page-section reveal">
  <div class="section-heading">
    <div><p class="eyebrow">Activity</p><h2>Recent expenses</h2></div>
    <a class="text-link" href="/expenses/new">Add quick entry <span aria-hidden="true">↗</span></a>
  </div>

  <% if (recentExpenses.length) { %>
    <div class="expense-list">
      <% recentExpenses.forEach((expense) => { %>
        <article class="expense-item">
          <div class="expense-info">
            <span class="expense-badge" style="background: <%= expense.category?.color || '#2d7958' %>"><%= expense.category?.icon || '•' %></span>
            <div>
              <strong><%= expense.category?.name || 'Uncategorized' %></strong>
              <small><%= expense.note || 'Expense entry' %> • <%= expense.dateLabel %></small>
            </div>
          </div>
          <div class="expense-amount-wrap">
            <span class="expense-amount"><%= currencySymbol %><%= expense.formattedAmount %></span>
            <div class="expense-actions">
              <a href="/expenses/<%= expense._id %>/edit">Edit</a>
              <form method="post" action="/expenses/<%= expense._id %>/delete">
                <button type="submit" class="link-button">Delete</button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon" aria-hidden="true">✦</div>
      <h3>Your spending story starts here</h3>
      <p>Add your first expense to see your activity take shape.</p>
      <button class="secondary-button" type="button" data-add-expense>Add your first expense</button>
    </div>
  <% } %>
</section>

<section class="quick-links page-section reveal" aria-label="More views">
  <a class="quick-link" href="#monthly"><span><strong>Monthly report</strong><small>See where your money goes</small></span><span aria-hidden="true">↗</span></a>
  <a class="quick-link" href="/categories"><span><strong>Categories</strong><small>Keep your labels tidy</small></span><span aria-hidden="true">↗</span></a>
</section>

<%- include('../partials/expense-modal') %>
