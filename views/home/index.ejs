<section class="dashboard-intro page-section reveal">
  <div>
    <p class="eyebrow">Your money, made clear</p>
    <h1>Good morning<span class="accent-dot">.</span></h1>
    <p class="intro-copy">A quiet view of your spending for <strong><%= monthName %></strong>.</p>
  </div>
  <button class="primary-button" type="button" data-add-expense>
    <span aria-hidden="true">+</span> Add expense
  </button>
</section>

<section class="summary-grid page-section reveal" aria-label="Monthly summary">
  <article class="summary-card summary-card-main">
    <div class="card-heading"><span>Spent this month</span><span class="status-pill">On track</span></div>
    <p class="amount-large"><%= currencySymbol %><%= summary.spent.toLocaleString('en-IN') %></p>
    <div class="progress-track" role="progressbar" aria-label="Monthly budget used" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"><span style="width: 0%"></span></div>
    <div class="card-meta"><span>Budget not set</span><span><%= currencySymbol %><%= summary.remaining.toLocaleString('en-IN') %> left</span></div>
  </article>
  <article class="summary-card">
    <span class="card-label">Today</span>
    <p class="amount-medium"><%= currencySymbol %><%= summary.today.toLocaleString('en-IN') %></p>
    <p class="muted-copy">No spending recorded yet</p>
  </article>
</section>

<section class="content-grid page-section reveal">
  <div class="section-heading">
    <div><p class="eyebrow">Activity</p><h2>Recent expenses</h2></div>
    <a class="text-link" href="#expenses">View all <span aria-hidden="true">↗</span></a>
  </div>
  <div class="empty-state">
    <div class="empty-icon" aria-hidden="true">✦</div>
    <h3>Your spending story starts here</h3>
    <p>Add your first expense to see your activity take shape.</p>
    <button class="secondary-button" type="button" data-add-expense>Add your first expense</button>
  </div>
</section>

<section class="quick-links page-section reveal" aria-label="More views">
  <a class="quick-link" href="#monthly"><span><strong>Monthly report</strong><small>See where your money goes</small></span><span aria-hidden="true">↗</span></a>
  <a class="quick-link" href="#trips"><span><strong>Trips</strong><small>Keep travel spending together</small></span><span aria-hidden="true">↗</span></a>
</section>
