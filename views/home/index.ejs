<section class="dashboard-intro page-section reveal">
  <div>
    <p class="eyebrow">Your money, made clear</p>
    <h1><%= greeting %><span class="accent-dot">.</span></h1>
    <p class="intro-copy">A quiet view of your spending for <strong><%= monthName %></strong>.</p>
  </div>
  <button class="primary-button" type="button" data-add-expense>
    <span aria-hidden="true">+</span> Add expense
  </button>
</section>

<section class="summary-grid page-section reveal" aria-label="Monthly summary">
  <article class="summary-card summary-card-main">
    <div class="card-heading">
      <span>Spent this month</span>
      <span class="status-pill"><%= summary.budgetAlert.label %></span>
    </div>
    <p class="amount-large"><%= currencySymbol %><%= summary.spent.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
    <div class="progress-track" role="progressbar" aria-label="Monthly budget used" aria-valuenow="<%= Math.round(summary.percentUsed) %>" aria-valuemin="0" aria-valuemax="100">
      <span style="width: <%= summary.progressWidth %>"></span>
    </div>
    <div class="card-meta">
      <span><%= summary.budget ? 'Budget set' : 'Budget not set' %></span>
      <span><%= currencySymbol %><%= summary.remaining.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %> left</span>
    </div>
  </article>
  <article class="summary-card">
    <span class="card-label">Today</span>
    <p class="amount-medium"><%= currencySymbol %><%= summary.today.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) %></p>
    <% if (summary.today > 0) { %>
      <p class="muted-copy">Tracked for today</p>
    <% } else { %>
      <p class="muted-copy">No spending recorded yet</p>
    <% } %>
  </article>
</section>

<% if (summary.budgetAlert) { %>
  <section class="page-section reveal">
    <div class="alert-banner alert-<%= summary.budgetAlert.tone %>">
      <strong><%= summary.budgetAlert.label %></strong>
      <span><%= summary.budget ? `You have used ${Math.round(summary.percentUsed)}% of your budget for the month.` : 'Set a monthly budget to start comparing your pace.' %></span>
    </div>
  </section>
<% } %>

<section class="insights-grid page-section reveal">
  <article class="summary-card">
    <span class="card-label">Insights</span>
    <p class="amount-medium"><%= insight.topCategory ? insight.topCategory.name : 'No category yet' %></p>
    <p class="muted-copy"><%= insight.topCategory ? `Top spending category at ${currencySymbol}${Number(insight.topCategory.total).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : 'Add expenses to unlock the category breakdown.' %></p>
    <div class="insight-pairs">
      <div>
        <small>Biggest expense</small>
        <strong><%= insight.biggestExpense ? `${currencySymbol}${Number(insight.biggestExpense.amount).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}` : '—' %></strong>
      </div>
      <div>
        <small>Vs. last month</small>
        <strong><%= insight.comparison ? `${insight.comparison >= 0 ? '+' : ''}${insight.comparison.toFixed(1)}%` : '—' %></strong>
      </div>
    </div>
  </article>
  <article class="summary-card">
    <span class="card-label">Quick stats</span>
    <div class="quick-stat-grid">
      <div>
        <small>Trips</small>
        <strong><%= trips.length %></strong>
      </div>
      <div>
        <small>Recurring</small>
        <strong><%= recurringCount %></strong>
      </div>
    </div>
  </article>
</section>

<section class="content-grid page-section reveal">
  <div class="section-heading">
    <div><p class="eyebrow">Activity</p><h2>Recent expenses</h2></div>
    <a class="text-link" href="/expenses/new">Add quick entry <span aria-hidden="true">↗</span></a>
  </div>

  <% if (recentExpenses.length) { %>
    <div class="expense-list">
      <% recentExpenses.forEach((expense) => { %>
        <article class="expense-item">
          <div class="expense-info">
            <span class="expense-badge" style="background: <%= expense.category?.color || '#2d7958' %>"><%= expense.category?.icon || '•' %></span>
            <div>
              <strong><%= expense.category?.name || 'Uncategorized' %></strong>
              <small><%= expense.note || 'Expense entry' %> • <%= expense.dateLabel %></small>
            </div>
          </div>
          <div class="expense-amount-wrap">
            <span class="expense-amount"><%= currencySymbol %><%= expense.formattedAmount %></span>
            <div class="expense-actions">
              <a href="/expenses/<%= expense._id %>/edit">Edit</a>
              <form method="post" action="/expenses/<%= expense._id %>/delete">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                <button type="submit" class="link-button">Delete</button>
              </form>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  <% } else { %>
    <div class="empty-state">
      <div class="empty-icon" aria-hidden="true">✦</div>
      <h3>Your spending story starts here</h3>
      <p>Add your first expense to see your activity take shape.</p>
      <button class="secondary-button" type="button" data-add-expense>Add your first expense</button>
    </div>
  <% } %>
</section>

<section class="quick-links page-section reveal" aria-label="More views">
  <a class="quick-link" href="/reports"><span><strong>Monthly report</strong><small>See where your money goes</small></span><span aria-hidden="true">↗</span></a>
  <a class="quick-link" href="/trips"><span><strong>Trips</strong><small>Keep your travel spending in check</small></span><span aria-hidden="true">↗</span></a>
  <a class="quick-link" href="/recurring"><span><strong>Recurring</strong><small>Subscriptions and fixed bills</small></span><span aria-hidden="true">↗</span></a>
  <a class="quick-link" href="/settings"><span><strong>Settings</strong><small>Currency, theme and preferences</small></span><span aria-hidden="true">↗</span></a>
</section>

<%- include('../partials/expense-modal') %>
