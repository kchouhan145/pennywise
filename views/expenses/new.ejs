<section class="page-section reveal">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Entry</p>
      <h2>Add expense</h2>
    </div>
    <a class="text-link" href="/">Back to home</a>
  </div>

  <form class="panel-form" method="post" action="/expenses">
    <% if (errors.length) { %>
      <div class="form-errors" role="alert">
        <% errors.forEach((error) => { %><p><%= error.msg %></p><% }) %>
      </div>
    <% } %>

    <label>
      Amount
      <input type="number" name="amount" min="0.01" step="0.01" value="<%= formData.amount %>" required autofocus />
    </label>

    <div class="input-row two-up">
      <label>
        Category
        <select name="category" required>
          <% categories.forEach((category) => { %>
            <option value="<%= category._id %>" <%= String(formData.category) === String(category._id) ? 'selected' : '' %>><%= category.name %></option>
          <% }) %>
        </select>
      </label>

      <label>
        Date
        <input type="date" name="date" value="<%= formData.date %>" required />
      </label>
    </div>

    <label>
      Note
      <input type="text" name="note" maxlength="240" value="<%= formData.note %>" placeholder="Optional note" />
    </label>

    <label>
      Payment method
      <select name="paymentMethod">
        <% ['Cash', 'UPI', 'Card', 'Other'].forEach((method) => { %>
          <option value="<%= method %>" <%= formData.paymentMethod === method ? 'selected' : '' %>><%= method %></option>
        <% }) %>
      </select>
    </label>

    <button class="primary-button" type="submit">Save expense</button>
  </form>
</section>
